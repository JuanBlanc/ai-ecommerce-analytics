# ============================================
# CONFIGURACION BASE DE DATOS
# ============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=empresa

# ============================================
# CONFIGURACION IA
# ============================================

# --- Opcion 1: Gemini (API externa) ---
# Mas rapido, requiere conexion a internet
# Obten tu API key en: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=tu_api_key_aqui

# --- Opcion 2: Ollama (local, sin API key) ---
# Si GEMINI_API_KEY esta vacio o comentado, usa Ollama automaticamente
# Modelos por defecto (se descargan automaticamente):
# SQL_MODEL=sqlcoder:7b
# CHAT_MODEL=llama3.1:8b

# ============================================
# NOTAS
# ============================================
# - Sin GPU: usa docker-compose.nogpu.yml
# - Con GPU NVIDIA: usa docker-compose.yml
# - Ollama descarga ~8GB de modelos la primera vez
aaa