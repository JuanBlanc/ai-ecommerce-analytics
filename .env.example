# ============================================
# CONFIGURACION BASE DE DATOS
# ============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=empresa

# ============================================
# CONFIGURACION IA
# ============================================

# --- Claude ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Gemini ---
# https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=

# --- Ollama (opcional, SQL gratis con GPU) ---
# https://ollama.com | https://hub.docker.com/r/ollama/ollama
# Usa sqlcoder para generar SQL sin gastar tokens
USE_OLLAMA=false

# ============================================
# PRIORIDAD
# ============================================
# SQL: Ollama (sqlcoder) > Claude > Gemini
# Análisis: Claude > Gemini
