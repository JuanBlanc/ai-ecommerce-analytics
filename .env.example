# ============================================
# CONFIGURACION BASE DE DATOS
# ============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=empresa

# ============================================
# CONFIGURACION IA
# ============================================

# --- Claude ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Gemini ---
# https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=

# --- Ollama (opcional, SQL gratis en local) ---
# Requiere Ollama instalado en TU ordenador (no se levanta ningun contenedor).
# https://ollama.com
#
#   1. Instalar y descargar el modelo:  ollama pull sqlcoder:7b
#   2. Exponer Ollama a los contenedores: OLLAMA_HOST=0.0.0.0 ollama serve
#      (por defecto solo escucha en 127.0.0.1 y el CORE no lo alcanzaria)
#   3. Poner USE_OLLAMA=true aqui
#
# Si no se detecta el servicio o el modelo, el CORE usa Claude/Gemini.
USE_OLLAMA=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=sqlcoder:7b

# ============================================
# PRIORIDAD
# ============================================
# SQL: Ollama local (sqlcoder) > Claude > Gemini
# Análisis: Claude > Gemini
