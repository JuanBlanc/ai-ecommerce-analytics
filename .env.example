# ============================================
# CONFIGURACION BASE DE DATOS
# ============================================
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=empresa

# ============================================
# CONFIGURACION IA
# ============================================

# --- Claude ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Backend compatible con OpenAI (opcional) ---
# Generico: sirve para cualquier proveedor que exponga la API de OpenAI.
# Solo hay que cambiar OPENAI_BASE_URL y OPENAI_MODEL.
#
#   OpenAI     -> https://api.openai.com/v1
#   OpenRouter -> https://openrouter.ai/api/v1
#   LM Studio  -> http://host.docker.internal:1234/v1
#
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- Ollama (opcional, SQL gratis en local) ---
# Requiere Ollama instalado en TU ordenador (no se levanta ningun contenedor).
# https://ollama.com
#
#   1. Instalar y descargar el modelo:  ollama pull sqlcoder:7b
#   2. Exponer Ollama a los contenedores: OLLAMA_HOST=0.0.0.0 ollama serve
#      (por defecto solo escucha en 127.0.0.1 y el CORE no lo alcanzaria)
#   3. Poner USE_OLLAMA=true aqui
#
# Si no se detecta el servicio, el CORE usa Claude o el compatible-OpenAI.
# El CORE lista todos los modelos instalados en GET /chat/modelos.
USE_OLLAMA=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=sqlcoder:7b

# ============================================
# PRIORIDAD
# ============================================
# SQL: Ollama local (sqlcoder) > Claude > compatible OpenAI
# Análisis: Claude > compatible OpenAI
